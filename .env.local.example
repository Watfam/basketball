# Copy this file to .env.local and fill in values from your Supabase
# project settings (Project Settings -> Data API). This is the SAME
# project Cardlocity uses — the app's own data lives in the isolated
# "hoops" Postgres schema, so nothing here collides with Cardlocity's
# tables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
